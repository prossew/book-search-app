<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookSearchApp.Views.AboutPage"
             Title="О программе"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Frame BackgroundColor="#2196F3"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="6">
                    <Label Text="BookSearchApp"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Приложение для поиска и каталогизации книг"
                           FontSize="15"
                           TextColor="White"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="15"
                   BorderColor="#DDDDDD"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Возможности приложения:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#212121" />
                    <Label Text="• Добавление новых книг в базу данных SQLite" TextColor="#424242" />
                    <Label Text="• Поиск книг по названию, автору или жанру" TextColor="#424242" />
                    <Label Text="• Просмотр полного каталога книг" TextColor="#424242" />
                    <Label Text="• Удаление выбранных книг из каталога" TextColor="#424242" />
                    <Label Text="• Обновление списка книг в реальном времени" TextColor="#424242" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="15"
                   BorderColor="#DDDDDD"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="О разработке:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#212121" />
                    <Label Text="Приложение разработано на .NET MAUI 8 с использованием базы данных SQLite." TextColor="#424242" />
                    <Label Text="Поддерживает кроссплатформенную разработку под Android." TextColor="#424242" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>