<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookSearchApp.Views.ItemPage"
             Title="Каталог книг">

    <ContentPage.Content>
        <StackLayout Spacing="0" VerticalOptions="FillAndExpand">

            <SearchBar x:Name="SearchBar"
                       Placeholder="Поиск по названию, автору или жанру..."
                       TextChanged="OnSearchTextChanged" />

            <ListView x:Name="BooksListView"
                      HasUnevenRows="true"
                      SeparatorVisibility="Default"
                      ItemSelected="OnBookSelected">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Padding="10" Spacing="5">
                                <Grid ColumnDefinitions="50,*,*" Padding="0,5">
                                    <Label Text="{Binding ID}"
                                           FontAttributes="Bold"
                                           Grid.Column="0" />
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           Grid.Column="1" />
                                    <Label Text="{Binding Author}"
                                           Grid.Column="2" />
                                </Grid>
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Label Text="{Binding Genre, StringFormat='Жанр: {0}'}" />
                                    <Label Text="{Binding Year, StringFormat='Год: {0}'}" />
                                    <Label Text="{Binding PageCount, StringFormat='Страниц: {0}'}" />
                                </StackLayout>
                                <BoxView HeightRequest="1" BackgroundColor="#DDDDDD" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Center"
                         Spacing="10"
                         Padding="10">
                <Button Text="Обновить список"
                        Clicked="OnRefreshClicked" />
                <Button Text="Удалить выбранную книгу"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="#F44336" />
            </StackLayout>

            <Label x:Name="StatusLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Green" />

        </StackLayout>
    </ContentPage.Content>

</ContentPage>