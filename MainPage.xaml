<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BookSearchApp.Views"
       x:Class="BookSearchApp.MainPage"
       Shell.BackgroundColor="#2196F3"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.UnselectedColor="#B3E5FC">

    <TabBar>
        <Tab Title="О программе" Icon="{x:Null}">
            <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
        </Tab>
        <Tab Title="Добавить книгу" Icon="{x:Null}">
            <ShellContent ContentTemplate="{DataTemplate views:AddItem}" />
        </Tab>
        <Tab Title="Каталог книг" Icon="{x:Null}">
            <ShellContent ContentTemplate="{DataTemplate views:ItemPage}" />
        </Tab>
    </TabBar>

</Shell>