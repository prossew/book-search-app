<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BookSearchApp.Views"
       x:Class="BookSearchApp.MainPage">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="ShellItem">
                <Setter Property="ForegroundColor" Value="#2196F3" />
                <Setter Property="UnselectedColor" Value="#757575" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <Tab Title="О программе" Icon="about.png">
            <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
        </Tab>
        <Tab Title="Добавить книгу" Icon="add.png">
            <ShellContent ContentTemplate="{DataTemplate views:AddItem}" />
        </Tab>
        <Tab Title="Каталог книг" Icon="catalog.png">
            <ShellContent ContentTemplate="{DataTemplate views:ItemPage}" />
        </Tab>
    </TabBar>

</Shell>