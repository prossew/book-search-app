<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookSearchApp</RootNamespace>
    <AssemblyName>BookSearchApp</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>false</AndroidKeyStore>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <NoWarn>$(NoWarn);NETSDK1202;MA002</NoWarn>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Release: отключаем линкер и AOT, чтобы не было белого экрана -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.100" />
    <PackageReference Include="sqlite-net-pcl" Version="1.8.116" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#2196F3" Condition="Exists('Resources/AppIcon/appicon.svg')" />
    <MauiSplashScreen Include="Resources/Splash/appicon.svg" BaseSize="128,128" Color="#2196F3" Condition="Exists('Resources/Splash/appicon.svg')" />
    <AndroidAsset Include="Resources/Raw/**" Condition="Exists('Resources/Raw')" />
    <AndroidResource Include="Resources/Values/**" Condition="Exists('Resources/Values')" />
  </ItemGroup>

</Project>